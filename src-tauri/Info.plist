<?xml version="1.0" encoding="UTF-8"?>
<!--
  Custom Info.plist entries MERGED into the Tauri-generated plist at build time
  (Tauri v2 merges src-tauri/Info.plist; only put the ADDED keys here, not the
  whole plist). See https://v2.tauri.app/distribute/macos-application-bundle/

  These are the macOS privacy (TCC) usage-description strings shown when the app
  first accesses a protected folder. They make the system prompt explicit; the
  grant only PERSISTS across app updates because the app now carries a stable
  code-signing identity (see bundle.macOS + the release workflow's APPLE_* env).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSDesktopFolderUsageDescription</key>
  <string>Flight Deck needs access to your Desktop to open and edit the files of projects you place there.</string>
  <key>NSDocumentsFolderUsageDescription</key>
  <string>Flight Deck needs access to your Documents to open and edit the files of projects you place there.</string>
  <key>NSDownloadsFolderUsageDescription</key>
  <string>Flight Deck needs access to your Downloads to open and edit the files of projects you place there.</string>
  <key>NSMicrophoneUsageDescription</key>
  <string>Flight Deck uses the microphone only while you talk to the voice agent (push-to-talk).</string>
  <!--
    Signing in to claude.ai inside the artifact panel. macOS only offers passkeys on THIS Mac
    (Touch ID / iCloud Keychain) to apps carrying Apple's browser entitlement
    (`com.apple.developer.web-browser.public-key-credential`), which is granted to browsers and
    needs an Apple-issued provisioning profile — this app is self-signed, so it will never have
    it. What WebKit falls back to is the cross-device passkey flow, where the passkey lives on
    your phone and answers over Bluetooth; without this string the system refuses that too, and
    the sign-in dies on "Make sure Bluetooth is on".
  -->
  <key>NSBluetoothAlwaysUsageDescription</key>
  <string>Flight Deck uses Bluetooth only to let you approve a claude.ai sign-in with a passkey from your phone.</string>
</dict>
</plist>
